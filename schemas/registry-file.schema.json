{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/d43pan/open-local/schemas/registry-file.schema.json",
  "title": "Open Local registry file",
  "description": "One place and the sources whose home is that place. The file path under registry/ is the place id plus .yaml.",
  "type": "object",
  "required": ["place"],
  "additionalProperties": false,
  "properties": {
    "place": {"$ref": "#/$defs/place"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "placeId": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 country code, then optional path segments, e.g. US, US/RI, US/RI/little-compton, GB/ENG/hebden-bridge.",
      "pattern": "^[A-Z]{2}(/[A-Za-z0-9]+(-[A-Za-z0-9]+)*)*$"
    },
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "url": {"type": "string", "pattern": "^https?://[^\\s]+$", "maxLength": 2000},
    "point": {
      "type": "object", "required": ["lat", "lon"], "additionalProperties": false,
      "properties": {"lat": {"type": "number", "minimum": -90, "maximum": 90}, "lon": {"type": "number", "minimum": -180, "maximum": 180}}
    },
    "place": {
      "type": "object",
      "required": ["id", "name", "kind", "country"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/placeId"},
        "name": {"type": "string", "minLength": 1},
        "kind": {
          "description": "A neutral class. Put the local word (town, parish, canton, ward, comune) in local_kind.",
          "enum": ["country", "region", "county", "municipality", "neighbourhood", "district", "natural", "custom"]
        },
        "local_kind": {"type": "string"},
        "country": {"type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2"},
        "subdivision": {"type": "string", "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$", "description": "ISO 3166-2"},
        "abbreviation": {"type": "string"},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "parents": {"type": "array", "items": {"$ref": "#/$defs/placeId"}, "description": "Areas that contain this place. More than one is fine."},
        "covers": {"type": "array", "items": {"$ref": "#/$defs/placeId"}, "description": "For areas that are not strict parents (a school district, a watershed, a named region): the places inside it."},
        "neighbors": {"type": "array", "items": {"$ref": "#/$defs/placeId"}},
        "adjacent_unmapped": {
          "type": "array",
          "description": "Places next to this one that are not in the registry yet. This is the frontier: where coverage can grow next. Move an entry to neighbors once its place file exists.",
          "items": {
            "type": "object", "required": ["name"], "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "wikidata": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
              "note": {"type": "string"}
            }
          }
        },
        "centroid": {"$ref": "#/$defs/point"},
        "postal_codes": {"type": "array", "items": {"type": "string"}},
        "languages": {"type": "array", "items": {"type": "string"}},
        "timezone": {"type": "string"},
        "identifiers": {
          "type": "object",
          "description": "Identifiers from open datasets, for joining with other data.",
          "additionalProperties": {"type": "string"},
          "properties": {
            "wikidata": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
            "geonames": {"type": "string", "pattern": "^[0-9]+$"},
            "osm_relation": {"type": "string", "pattern": "^[0-9]+$"},
            "ocd_division": {"type": "string", "pattern": "^ocd-division/country:[a-z]{2}(/[a-z_]+:[^/\\s]+)*$"},
            "us_census_geoid": {"type": "string", "pattern": "^[0-9]{2,10}$"}
          }
        },
        "notes": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "name", "url", "type", "classification", "discovered", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 96, "description": "Stable and unique across the registry. Starts with the home place id in lower case with hyphens, e.g. us-ri-little-compton-town-council. Never reused."},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "maxLength": 600},
        "publisher": {"type": "string"},
        "url": {"$ref": "#/$defs/url"},
        "type": {
          "enum": ["newspaper", "news-site", "journalist", "newsletter", "blog", "government", "meetings", "planning-zoning",
                   "schools", "budget", "permits", "public-notices", "library", "parks-recreation", "community-organization",
                   "chamber-of-commerce", "religious", "events", "podcast", "radio", "television", "public-access-tv",
                   "meeting-video", "transportation", "emergency", "public-safety", "public-health", "environment",
                   "history", "forum", "utility",
                   "food-drink", "farm-market", "arts-culture", "museum", "performance-venue", "business", "tourism",
                   "sports", "other"]
        },
        "classification": {
          "description": "primary: first-hand. A body publishing its own records, a venue its own hours and events, a farm its own stand, a newsroom its own reporting. secondary: lists, rewrites, aggregates or syndicates what others published. mixed: both.",
          "enum": ["primary", "secondary", "mixed"]
        },
        "coverage": {
          "type": "array", "minItems": 1,
          "description": "What the source covers, which may differ from where its publisher sits. Omit to mean: dedicated to the home place.",
          "items": {
            "type": "object", "required": ["place"], "additionalProperties": false,
            "properties": {
              "place": {"$ref": "#/$defs/placeId"},
              "level": {"enum": ["dedicated", "regular", "occasional"], "default": "regular"},
              "note": {"type": "string"}
            }
          }
        },
        "jurisdiction": {"$ref": "#/$defs/placeId", "description": "For a public body: the place it governs."},
        "location": {
          "type": "object", "additionalProperties": false,
          "description": "Where the publisher is, if known. Not used to decide relevance.",
          "properties": {"place": {"$ref": "#/$defs/placeId"}, "point": {"$ref": "#/$defs/point"}, "address": {"type": "string"}}
        },
        "languages": {"type": "array", "items": {"type": "string"}, "description": "BCP 47 tags"},
        "topics": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object", "required": ["kind", "url"], "additionalProperties": false,
            "properties": {
              "kind": {"enum": ["rss", "atom", "jsonfeed", "ical", "api", "sitemap", "html", "video", "podcast", "documents"]},
              "url": {"$ref": "#/$defs/url"},
              "title": {"type": "string"},
              "note": {"type": "string"}
            }
          }
        },
        "frequency": {"enum": ["continuous", "daily", "weekly", "biweekly", "monthly", "quarterly", "irregular", "unknown"]},
        "access": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "paywall": {"enum": ["none", "metered", "hard", "registration", "unknown"]},
            "license": {"type": "string", "description": "Licence of the source's own content, if it states one. Not granted by this registry."},
            "restrictions": {"type": "string", "description": "Known limits: robots.txt rules, terms, rate limits, AI-use statements."}
          }
        },
        "platform": {"type": "string"},
        "discovered": {"$ref": "#/$defs/date"},
        "verified": {"$ref": "#/$defs/date"},
        "status": {
          "description": "verified: loaded on the verified date and reviewed by a person who knows the place. checked: loaded by a tool on the verified date, not yet reviewed by a local person. unverified: proposed, not yet checked. broken: stopped loading. stale: loads but has stopped publishing. retired: gone for good; kept so the id is never reused.",
          "enum": ["verified", "checked", "unverified", "broken", "stale", "retired"]
        },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "added_by": {"type": "string", "description": "A public handle or organisation, never an email address."},
            "method": {"enum": ["human", "agent-proposed", "import"]},
            "evidence": {"type": "string", "description": "How it was found or checked."}
          }
        },
        "notes": {"type": "string"}
      }
    }
  }
}
